% ==============================================================================
%  Transactions on Machine Learning Research (TMLR) LaTeX Style File
%  Official geometry, double-blind headers, and title/author formatting
% ==============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tmlr}[2026/01/01 TMLR Submission Package]

\newif\iftmlrfinal\tmlrfinalfalse
\newif\iftmlrpreprint\tmlrpreprintfalse

\DeclareOption{accepted}{\tmlrfinaltrue}
\DeclareOption{preprint}{\tmlrpreprinttrue}
\ProcessOptions\relax

% --- Page Geometry ---
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\setlength{\textwidth}{6.5in}
\setlength{\textheight}{9.0in}
\setlength{\topmargin}{-0.625in}
\setlength{\oddsidemargin}{0in}
\setlength{\evensidemargin}{0in}
\setlength{\headheight}{12pt}
\setlength{\headsep}{0.25in}
\setlength{\marginparwidth}{0.07in}

% --- Headers & Footers ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

\iftmlrfinal
  \chead{\scriptsize Published in Transactions on Machine Learning Research}
\else
  \iftmlrpreprint
    \chead{}
  \else
    \chead{\scriptsize Under review as a submission to Transactions on Machine Learning Research (TMLR)}
  \fi
\fi
\cfoot{\thepage}

% --- Title & Author Formatting ---
\def\maketitle{
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}
    \newpage
    \null
    \vskip 1.5em
    \begin{center}
      {\LARGE\bf \@title \par}
      \vskip 1.5em
      \iftmlrfinal
        {\large \@author \par}
      \else
        \iftmlrpreprint
          {\large \@author \par}
        \else
          {\large \textbf{Anonymous authors} \par}
          \vskip 0.5em
          {\normalsize Paper under double-blind review \par}
        \fi
      \fi
    \end{center}
    \par
    \vskip 1.5em
  \endgroup
  \setcounter{footnote}{0}
}

% --- Section Formatting ---
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\small\bfseries}{\thesubsubsection}{1em}{}

% --- Abstract Formatting ---
\renewenvironment{abstract}
{
  \begin{center}
    {\bfseries\large Abstract}
  \end{center}
  \quotation
}
{\endquotation\vskip 1em}

\endinput
